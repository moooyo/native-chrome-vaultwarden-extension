{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "key": "",
  "name": "密屿 MiYu",
  "version": "0.0.2",
  "description": "密屿 · 兼容 Bitwarden / Vaultwarden 的原生 MV3 密码管理器。",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "ui/popup/popup.html",
    "default_title": "密屿",
    "default_icon": {
      "16": "icons/icon16_neutral.png",
      "32": "icons/icon32_neutral.png",
      "48": "icons/icon48_neutral.png",
      "128": "icons/icon128_neutral.png"
    }
  },
  "options_ui": {
    "page": "ui/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "clipboardRead",
    "clipboardWrite",
    "contextMenus",
    "idle",
    "notifications",
    "offscreen",
    "activeTab",
    "webNavigation",
    "webRequest",
    "webRequestAuthProvider",
    "scripting"
  ],
  "host_permissions": [
    "https://api.pwnedpasswords.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/autofill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "autofill-focused": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "从密屿填充当前聚焦的登录字段"
    },
    "autofill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Fill or cycle matching logins for the current site"
    },
    "autofill-card": {
      "description": "Fill or cycle cards for the current site"
    },
    "autofill-identity": {
      "description": "Fill or cycle identities for the current site"
    },
    "generate-password": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "Generate a password and copy it to the clipboard"
    },
    "lock-vault": {
      "description": "Lock the vault"
    },
    "open-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open the extension popup"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/fonts/*.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
