{
  "name": "vaultwarden-extension",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:prod": "node build.mjs --prod && node tools/assert-build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "test:ui": "node build.mjs && node tools/verify-render.mjs",
    "verify:render": "node tools/verify-render.mjs",
    "verify:autofill-browser": "node tools/verify-autofill-browser.mjs",
    "verify:binary-transport-browser": "node tools/verify-binary-transport-browser.mjs",
    "verify:e2e": "node tools/verify-e2e.mjs",
    "verify:ssh-e2e": "node tools/verify-ssh-e2e.mjs",
    "verify:passkey-e2e": "node tools/verify-passkey-e2e.mjs",
    "verify:device-login-e2e": "node tools/verify-device-login-e2e.mjs",
    "verify:account-passkey-e2e": "node tools/verify-account-passkey-e2e.mjs",
    "verify:http-auth-e2e": "node tools/verify-http-auth-e2e.mjs",
    "serve:testpage": "node test-page/serve.mjs",
    "seed:testvault": "esbuild tools/seed-test-vault.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/miyu-seed.mjs && node node_modules/.cache/miyu-seed.mjs",
    "release:prepare": "node tools/release.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.0",
    "@microsoft/signalr-protocol-msgpack": "10.0.0",
    "hash-wasm": "4.12.0",
    "lit": "^3.3.3",
    "micro-key-producer": "0.10.2",
    "qrcode-parser": "2.1.3",
    "safe-regex2": "^5.1.1",
    "tldts": "^7.4.9",
    "webextension-polyfill": "^0.12.0",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@types/webextension-polyfill": "^0.12.5",
    "@types/zxcvbn": "4.4.5",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "fflate": "^0.8.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
